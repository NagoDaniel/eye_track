# Copy to `.env` and edit. `scripts/setup.sh` can do this for you and generates the secrets.
# Never commit `.env`.

# --- Public address and TLS (HTTPS is mandatory: browsers only allow the camera on secure origins)
# Host name participants use. Must resolve to this server when TLS_MODE=acme.
DOMAIN=eyetrack.example.org
# Optional contact address for Let's Encrypt expiry reminders (TLS_MODE=acme only). Leave as is or
# empty to request certificates without one.
ACME_EMAIL=you@example.org
# acme     = public domain, ports 80 and 443 reachable from the internet; certificate is automatic.
# files    = your own certificate (e.g. from university IT); set the two paths below.
# internal = Caddy's local CA, for an internal lab network (the README explains how to trust it).
TLS_MODE=acme
# Host paths of the certificate and private key (TLS_MODE=files only); mounted read-only into the proxy.
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Storage
# Host directory for recordings, derived data and videos. Put it on an encrypted volume.
DATA_DIR=./data
# Host directory for the Pipeline B model weights (filled by scripts/fetch_models.sh). Optional.
MODELS_DIR=./models

# --- Secrets (scripts/setup.sh replaces "change-me" with random values on first run)
# Password of the PostgreSQL user. Set it BEFORE the first start: the database keeps it afterwards.
POSTGRES_PASSWORD=change-me
# Signs admin session cookies and CSRF tokens. At least 32 characters. Changing it logs every admin out.
SECRET_KEY=change-me

# --- Tuning
# Number of uvicorn worker processes in the api container.
API_WORKERS=2
# Processing jobs run in parallel by the worker container (1 is the only supported value for now).
WORKER_CONCURRENCY=1
# cpu | cuda. Pipeline B inference provider.
ONNX_PROVIDER=cpu
# Largest request body on /api (one recording chunk), in MiB. Enforced by the proxy.
MAX_UPLOAD_CHUNK_MB=10
# Largest stimulus video upload in the admin interface, in MiB. Enforced by the proxy and the app.
MAX_VIDEO_UPLOAD_MB=2048
# Largest body of any other admin request (login form, JSON), in MiB. Enforced by the proxy.
MAX_ADMIN_REQUEST_MB=1
# DEBUG | INFO | WARNING | ERROR. Logs are JSON lines; media and landmarks are never logged.
LOG_LEVEL=INFO

# --- Ports (leave unchanged in production; Let's Encrypt needs 80 and 443)
HTTP_PORT=80
HTTPS_PORT=443
